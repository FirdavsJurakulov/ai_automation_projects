      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "GEMINI_AI_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ systemInstruction: { parts: [{ text: \"You are a lead-qualification assistant for a digital marketing agency in Tashkent (services: SMM, targeted ads, branding, websites, video production, AI automation).\\nRead the client's Telegram message and return ONLY JSON with these keys:\\nname (string or null), phone (string or null), service (one of: SMM, Targeting, Branding, Website, Video, AI Automation, Other),\\nbudget_uzs (number or null, convert '$' to UZS at 12,700), urgency (low|medium|high), language (ru|uz|en),\\nlead_score (1-10: higher if budget, clear need, contact and urgency are given), summary (one short sentence in Russian),\\nreply_text (a friendly reply to the client IN THEIR LANGUAGE: thank them, confirm what you understood, and ask for any missing info among name, phone, budget, deadline. Max 3 sentences).\\nNever invent data that is not in the message.\" }] }, contents: [{ role: 'user', parts: [{ text: $json.message.text || '' }] }], generationConfig: { temperature: 0.2, responseMimeType: 'application/json' } }) }}",
        "options": {}
      },
      "id": "ee1251c9-703c-41e5-a7b7-a795730f8cbb",
      "name": "Gemini: qualify lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 128]
    },
    {
      "parameters": {
        "jsCode": "// Parse Gemini's JSON answer and attach Telegram metadata\nconst tg = $('Telegram Trigger').first().json.message;\nconst raw = $json.candidates?.[0]?.content?.parts?.[0]?.text ?? '{}';\nlet lead;\ntry { lead = JSON.parse(raw); } catch (e) { lead = { summary: 'parse_error', reply_text: 'Спасибо! Менеджер скоро свяжется с вами.', lead_score: 0 }; }\nreturn [{ json: {\n  date: new Date().toISOString(),\n  chat_id: tg.chat.id,\n  username: tg.from.username ? '@' + tg.from.username : '',\n  message: tg.text || '',\n  name: lead.name ?? '',\n  phone: lead.phone ?? '',\n  service: lead.service ?? 'Other',\n  budget_uzs: lead.budget_uzs ?? '',\n  urgency: lead.urgency ?? 'low',\n  language: lead.language ?? 'ru',\n  lead_score: Number(lead.lead_score ?? 0),\n  summary: lead.summary ?? '',\n  reply_text: lead.reply_text ?? ''\n}}];"
      },
